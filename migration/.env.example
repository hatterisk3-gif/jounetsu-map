# ==============================================================================
# 情熱MAP Supabase + Cloudflare R2 接続設定（サンプル）
# 使い方: このファイルをコピーして migration/.env を作成し、実値を記入してください。
# 注意: migration/.env は .gitignore 対象です。絶対に Git にコミットしないでください。
# ==============================================================================

# --- Supabase 接続情報 (Dashboard > Settings > API) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# 移行スクリプト・疎通チェック用（クライアント側には絶対に埋め込まないこと）
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- Cloudflare R2 接続情報 (Cloudflare Dashboard > R2) ---
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=jounetsu-map-media
# R2バケットの公開URL（カスタムドメイン または r2.dev URL、末尾スラッシュなし）
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# --- Phase 1 以降: 既存 GAS / スプレッドシート移行用 ---
LEGACY_GAS_URL=https://script.google.com/macros/s/AKfycbzqga3_gw7fKTFdOieVZbudC36yP7_xKWiYPu4XyPIg8ahwe2y7JcB93sGyUTrHGQWV/exec
LEGACY_MASTER_SPREADSHEET_ID=1Kfg5JzNE8pZVQuyuHExz1Q00vzd75MmWrtKLLHUG89c
